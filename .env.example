# ===================================================================
#  .env.example — سيدي يوسف بن علي العاصمة
#  انسخ هذا الملف إلى .env وأدخل القيم الحقيقية
#  ⚠️ لا تُرفع .env إلى Git — فقط .env.example
# ===================================================================

# ─────────── قاعدة البيانات ───────────
# محلياً (SQLite):
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# إنتاجاً (Supabase PostgreSQL — Pooler):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# ─────────── NextAuth ───────────
# ولّد سرّاً جديداً: openssl rand -hex 32
NEXTAUTH_SECRET="غيّرني-بـ-openssl-rand-hex-32"

# محلياً:
NEXTAUTH_URL="http://localhost:3000"
# إنتاجاً:
# NEXTAUTH_URL="https://syba-community.vercel.app"

# ─────────── وضع العرض التوضيحي ───────────
# true: /demo-access تعمل (عرض الـdemo)
# false: /demo-access تعود 404 (إلزامي للإنتاج)
DEMO_MODE=true

# ─────────── SMTP (البريد) ───────────
# محلياً (MailHog): smtp-host=localhost, smtp-port=1025
# إنتاجاً (Brevo): smtp-relay.brevo.com, port=587
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="سيدي يوسف بن علي العاصمة <test@syba.local>"
# false افتراضياً — فعّله بعد إضافة بيانات Brevo
SMTP_ENABLED="true"

# ─────────── CRON_SECRET — يُستعمل لتوثيق طلبات GitHub Actions ───────────
# ولّد سرّاً: openssl rand -hex 32
# يُستعمل في /api/cron/prices و /api/admin/prices/cleanup
CRON_SECRET="غيّرني-بـ-openssl-rand-hex-32"

# ─────────── اختياري ───────────
# NEXT_PUBLIC_SITE_NAME="سيدي يوسف بن علي العاصمة"
