// ملاحظة: PriceReport نُقل إلى أسفل الملف (v15.0) بحقول موسّعة + علاقة User

model PriceFetchLog {
  id            String   @id @default(cuid())
  source        String
  status        String   // SUCCESS, FAILED, PARTIAL, FALLBACK
  productsCount Int      @default(0)
  errorMessage  String?
  durationMs    Int?
  fetchedAt     DateTime @default(now())
  @@index([source, fetchedAt])
  @@index([fetchedAt])
}

// ===================================================================
//  v15.0 — CNDP (اللجنة الوطنية لمراقبة حماية البيانات)
//  قانون 09-08 — إلزامي قانونياً (غرامة تصل إلى 300,000 درهم)
//
//  يحق لكل شخص طلب:
//   - الاطّلاع على بياناته (حق الوصول)
//   - تصحيح بياناته (حق التصحيح)
//   - حذف بياناته (حق المحو)
//   - تقييد المعالجة (حق التقييد)
//   - نقل بياناته (حق النقل)
//   - الاعتراض على المعالجة (حق الاعتراض)
//
//  يلتزم النظام بالاستجابة في أجل أقصاه 30 يوماً (المادة 31 من 09-08)
// ===================================================================

enum CndpRequestType {
  ACCESS        // حق الوصول
  RECTIFICATION // حق التصحيح
  ERASURE       // حق المحو
  RESTRICTION  // حق تقييد المعالجة
  PORTABILITY   // حق النقل
  OBJECTION     // حق الاعتراض
}

enum CndpRequestStatus {
  PENDING       // قيد الانتظار (لم تُعالج)
  IN_REVIEW     // قيد الدراسة
  APPROVED       // مقبولة + نُفّذت
  PARTIALLY     // نُفّذت جزئياً
  REJECTED      // مرفوضة (مع تسبيب)
  EXPIRED       // انقضت مهلة 30 يوماً دون استجابة
}

model CndpRequest {
  id              String            @id @default(cuid())
  // صاحب الطلب
  fullName        String            // الاسم الكامل لصاحب الطلب
  email           String            // بريد إلكتروني للتواصل
  phone           String?           // هاتف اختياري
  nationalId      String?           // رقم البطاقة الوطنية (مُعمّى عند التخزين)
  userId          String?           // إذا كان المستخدم مُسجّلاً (ربط بالحساب)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  // تفاصيل الطلب
  requestType     CndpRequestType
  description     String            // وصف الطلب التفصيلي (محرر للإدخال)
  targetData      String?          // نوع البيانات المعنية (مثلاً: الملف الشخصي، الرسائل، المساهمات)
  districtId      String?           // الحي المعني (لو وُجد)
  // إثبات الهوية (إرفاق وثيقة)
  identityDocUrl  String?           // URL لوثيقة إثبات (للطلبات الحساسة)
  // التتبّع
  status          CndpRequestStatus @default(PENDING)
  assignedTo      String?           // معالِج معيّن (SUPER_ADMIN أو DPO)
  adminResponse   String?           // ردّ الإدارة النصّي
  processedAt     DateTime?         // وقت الاستجابة النهائية
  expiresAt       DateTime          // أقصى أجل = createdAt + 30 يوماً
  // التدقّق
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([requestType, status])
  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([status, assignedTo])
}

// ===================================================================
//  v15.0 — نماذج مساهمة المستخدمين (4 أنواع)
//  كل نموذج يخضع للمراجعة من طرف مشرف معتمد قبل النشر.
// ===================================================================

// 1) تقرير سعر — مراجعة المساهمات بأسعار السوق التي يُبلّغ بها المستخدمون
model PriceReport {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String?  // ربط بمنتج معيّن (إن وُجد)
  productName     String   // اسم المنتج (مطلوب)
  productNameAr   String   // الاسم بالعربية
  category        String   // VEGETABLE, FRUIT, MEAT, GRAIN, DAIRY
  price           Float    // الدرهم
  unit            String   @default("درهم/كغ")
  marketName      String?  // اسم السوق
  districtId      String?
  notes           String?
  // المراجعة
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy      String?
  reviewer        User?    @relation("PriceReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  adminNote       String?
  reviewedAt      DateTime?
  // إثبات (صورة إيصال / صورة من السوق)
  proofUrl        String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status, createdAt])
  @@index([category, status])
  @@index([districtId])
}

// 2) تقييم خدمة — مراجعة تقييمات الخدمات (Service + ServiceReview العائد لـ v14.1)
// نُنشئ هذا النموذج الموسّع ليُحدّث ServiceReview ويربطه بنظام المراجعة
model ServiceReviewSubmission {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String   // الخدمة المعنية
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  rating          Int      // 1-5
  title           String
  body            String
  // المراجعة
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, FLAGGED
  reviewedBy      String?
  reviewer        User?    @relation("ServiceReviewReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  adminNote       String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status, createdAt])
  @@index([serviceId, status])
}

// 3) اقتراح فعالية — يقترح المستخدم فعالية جديدة للمجتمع
model EventProposal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String
  proposedDate    DateTime
  location        String?
  districtId      String?
  expectedAttendees Int?
  category        String?  // SOCIAL, EDUCATIONAL, CHARITY, CULTURAL
  budget          Float?
  // المراجعة
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, CONVERTED
  reviewedBy      String?
  reviewer        User?    @relation("EventProposalReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  adminNote       String?
  reviewedAt      DateTime?
  // ربط لو تحوّلت إلى Event فعلي
  convertedEventId String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status, createdAt])
  @@index([districtId])
}

// 4) قصة نجاح — يُرسل المستخدم قصة نجاحه مع المجتمع
model StorySubmission {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  body            String   // النص الكامل
  consentGiven    Boolean  @default(false) // الموافقة على النشر
  anonymize       Boolean  @default(true) // نشر باسم مجهول افتراضياً
  imageUrl        String?
  districtId      String?
  // المراجعة
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, PUBLISHED
  reviewedBy      String?
  reviewer        User?    @relation("StoryReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  adminNote       String?
  reviewedAt      DateTime?
  publishedAt     DateTime? // لو نُشرت كمقال
  blogPostId      String?  // ربط بـBlogPost لو تحوّلت لمقال منشور
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status, createdAt])
  @@index([districtId])
}

// ===================================================================
//  v22.0 — Feature Flags: مركز التحكم في أقسام المنصة
//  توقيف/تشغيل/قريباً/صيانة لكل قسم
// ===================================================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  nameAr      String
  description String?
  category    String?
  status      String   @default("ACTIVE") // ACTIVE, HIDDEN, MAINTENANCE, COMING_SOON, DISABLED
  message     String?
  startsAt    DateTime?
  endsAt      DateTime?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key, status])
  @@index([status])
  @@index([category, status])
}

// ===================================================================
//  v30.0 — CMS: SiteContent + ImageAsset (admin-controlled content)
// ===================================================================

model SiteContent {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("TEXT")
  section     String
  labelAr     String
  description String?
  isActive    Boolean  @default(true)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([section])
}

model ImageAsset {
  id          String   @id @default(cuid())
  key         String   @unique
  url         String
  alt         String
  section     String
  labelAr     String
  description String?
  isActive    Boolean  @default(true)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([section])
}

// ===================================================================
//  v38.0 — نماذج التحكم في المتصدرين (Leaderboard Admin)
// ===================================================================

model LeaderboardConfig {
  id              String   @id @default(cuid())
  period          String   @unique // WEEKLY, MONTHLY, YEARLY, ALL_TIME
  isActive        Boolean  @default(true)
  isVisible       Boolean  @default(true) // للعموم
  minPoints       Int      @default(0) // حد أدنى للظهور
  topN            Int      @default(10) // عدد المتصدرين
  showAvatars     Boolean  @default(true)
  showDistricts   Boolean  @default(true)
  showBadges      Boolean  @default(true)
  reward1st      Int      @default(500)
  reward2nd      Int      @default(250)
  reward3rd      Int      @default(100)
  customMessage   String?
  updatedBy       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model LeaderboardBan {
  id        String    @id @default(cuid())
  userId    String
  reason    String
  bannedBy  String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@index([expiresAt])
}

// ===================================================================
//  v38.0 Section 2 — نماذج صندوق المعروف (Fund Admin)
// ===================================================================

model FundAccountInfo {
  id              String   @id @default(cuid())
  bankName        String?
  accountHolder   String?
  rib             String?
  iban            String?
  swift           String?
  paypalEmail     String?
  cashplusNumber  String?
  inwiMoney       String?
  orangeMoney     String?
  customNote      String?
  isVisible       Boolean  @default(true)
  updatedBy       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model FundDonation {
  id            String   @id @default(cuid())
  userId        String?
  amount        Float
  currency      String   @default("MAD")
  method        String   // BANK_TRANSFER, CASHPLUS, PAYPAL, CASH, INWI_MONEY
  reference     String?
  receiptUrl    String?
  status        String   @default("PENDING") // PENDING, CONFIRMED, REJECTED
  confirmedBy   String?
  confirmedAt   DateTime?
  rejectionNote String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([method])
}

model FundSettings {
  id                 String   @id @default(cuid())
  isOpen             Boolean  @default(true)
  minDonation        Float    @default(10)
  maxDonation        Float    @default(10000)
  allowAnonymous     Boolean  @default(true)
  requireReceipt     Boolean  @default(true)
  publicTransparency Boolean  @default(true)
  thankYouMessage    String?
  updatedBy          String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

// ===================================================================
//  v38.0 Section 3 — نماذج التفاعل (Reactions + Follow + Like + View + Share)
// ===================================================================

model Reaction {
  id         String   @id @default(cuid())
  userId     String
  targetType String   // POST, COMMENT, EVENT, SERVICE, ARTICLE, PRODUCT, INITIATIVE
  targetId   String
  type       String   // LIKE, LOVE, WOW, SAD, ANGRY
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId, type])
  @@index([targetType, targetId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  targetType  String   // USER, DISTRICT, GROUP, INITIATIVE
  createdAt   DateTime @default(now())

  follower User @relation("FollowGiven", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowReceived", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId, targetType])
  @@index([followingId])
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model View {
  id         String   @id @default(cuid())
  userId     String?
  targetType String
  targetId   String
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model Share {
  id         String   @id @default(cuid())
  userId     String?
  targetType String
  targetId   String
  platform   String   // WHATSAPP, FACEBOOK, TWITTER, TELEGRAM, COPY_LINK
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

// ===================================================================
//  v38.0 Section 4 — نماذج الإحالة الموسّعة (Referral Pro)
// ===================================================================

model ReferralProgram {
  id                String   @id @default(cuid())
  isActive          Boolean  @default(true)
  rewardReferrer    Int      @default(50)
  rewardReferred     Int      @default(30)
  rewardOnFirstAction Int    @default(20)
  maxReferrals      Int?
  isVisible         Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model ReferralCampaign {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  startDate   DateTime
  endDate     DateTime
  multiplier  Float    @default(2.0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ReferralLink {
  id          String   @id @default(cuid())
  userId      String
  code        String   @unique
  campaignId  String?
  clicks      Int      @default(0)
  signups     Int      @default(0)
  activeReferrals Int  @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===================================================================
//  v38.0 Section 5 — نماذج المحفظة (Wallet System)
// ===================================================================

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  balance      Float    @default(0)
  points       Int      @default(0)
  currency     String   @default("MAD")
  isActive     Boolean  @default(true)
  dailyLimit   Float    @default(5000)
  monthlyLimit Float    @default(20000)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String   // TOPUP, PURCHASE, REFUND, WITHDRAWAL, REWARD, TRANSFER
  amount      Float
  currency    String   @default("MAD")
  method      String?
  status      String   @default("PENDING")
  reference   String?
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([status])
}

model PointPackage {
  id          String   @id @default(cuid())
  name        String
  points      Int
  price       Float
  bonus       Int      @default(0)
  isActive    Boolean  @default(true)
  isPopular   Boolean  @default(false)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
}

model WithdrawalRequest {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  method      String
  accountInfo String
  status      String   @default("PENDING")
  adminNote   String?
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

// ===================================================================
//  v39.0 Section 2 — نماذج التفاعل الإضافية (Bookmark + Comment)
// ===================================================================

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  content    String
  parentId   String?
  likes      Int      @default(0)
  isApproved Boolean  @default(true)
  isEdited   Boolean  @default(false)
  isPinned   Boolean  @default(false)
  isFake     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[]  @relation("CommentReplies")

  @@index([targetType, targetId])
  @@index([parentId])
  @@index([createdAt])
}

// ===================================================================
//  v39.0 Section 3 — نماذج الفيديو (TikTok-Style)
// ===================================================================

model Video {
  id             String   @id @default(cuid())
  userId         String
  title          String
  description    String?
  sourceUrl      String
  sourcePlatform String   // TIKTOK, YOUTUBE, INSTAGRAM, FACEBOOK
  thumbnailUrl   String?
  duration       Int?
  views          Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  category       String?
  isApproved     Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoLikes    VideoLike[]
  videoComments VideoComment[]
  videoBookmarks VideoBookmark[]

  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@index([isFeatured])
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

model VideoComment {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  content   String
  parentId  String?
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model VideoBookmark {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

// ===================================================================
//  v39.0 Section 4 — إعدادات الفيديو
// ===================================================================

model VideoSettings {
  id                String   @id @default(cuid())
  isEnabled         Boolean  @default(true)
  requireApproval   Boolean  @default(true)
  maxVideosPerUser  Int      @default(50)
  allowYouTube      Boolean  @default(true)
  allowTikTok       Boolean  @default(true)
  allowInstagram    Boolean  @default(true)
  allowFacebook     Boolean  @default(false)
  defaultCategory   String?
  allowComments     Boolean  @default(true)
  allowLikes        Boolean  @default(true)
  allowShare        Boolean  @default(true)
  allowBookmark     Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model StatsAdjustment {
  id          String   @id @default(cuid())
  adminId     String
  targetType  String
  targetId    String
  field       String
  amount      Int
  reason      String?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([adminId])
}

// ===================================================================
//  v47.0 — نماذج التعليقات المحسّنة + القوالب الجاهزة
// ===================================================================

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model FakeCommentTemplate {
  id         String   @id @default(cuid())
  content    String
  targetType String?
  category   String?
  usageCount Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model AdminCommentBoost {
  id         String   @id @default(cuid())
  adminId    String
  targetType String
  targetId   String
  count      Int
  reason     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

// ===================================================================
//  v55.0 — Feed الموحّد (Social Network)
// ===================================================================

model FeedItem {
  id          String   @id @default(cuid())
  userId      String
  type        String   // POST, VIDEO, EVENT, CONTRIBUTION, FUND_REQUEST, SERVICE, INITIATIVE, STATUS
  targetId    String?
  content     String?
  mediaUrls   String   @default("[]") // JSON array
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  views       Int      @default(0)
  // v61.0 Part 5: Reddit-style upvote/downvote (Karma)
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  // Score = upvotes - downvotes (cached for performance)
  score       Int      @default(0)
  visibility  String   @default("DISTRICT")
  districtId  String?
  createdAt   DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes FeedVote[]
  awards PostAward[]

  @@index([userId])
  @@index([type])
  @@index([districtId])
  @@index([createdAt])
  @@index([score])
}

// v61.0 Part 5: سجلّ تصويتات المستخدمين على المنشورات (Reddit-style)
model FeedVote {
  id          String   @id @default(cuid())
  userId      String
  feedItemId  String
  // value: 1 = upvote, -1 = downvote, 0 = removed (kept for history)
  value       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItem  FeedItem  @relation(fields: [feedItemId], references: [id], onDelete: Cascade)

  @@unique([userId, feedItemId])
  @@index([userId])
  @@index([feedItemId])
}

// v61.0 Part 5: Reddit-style Post Awards (جوائز المنشورات)
model PostAward {
  id          String   @id @default(cuid())
  userId      String   // من يُعطي الجائزة
  feedItemId  String   // المنشور المُكافأ
  awardType   String   // GOLD, SILVER, BRONZE, HELPFUL, FUNNY, WHOLESOME, INSPIRING
  karmaCost  Int      // كم كلّف الجائزة (يُخصم من المانح)
  karmaReward Int      // كم ربح صاحب المنشور
  note        String?  // ملاحظة اختيارية
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItem  FeedItem  @relation(fields: [feedItemId], references: [id], onDelete: Cascade)

  @@unique([userId, feedItemId, awardType]) // جائزة واحدة من كل نوع لكل مستخدم لكل منشور
  @@index([userId])
  @@index([feedItemId])
  @@index([awardType])
}

// v61.0 Part 5: LinkedIn-style Skills + Endorsements
model Skill {
  id        String   @id @default(cuid())
  userId    String
  name      String   // lowercase skill name (e.g. "تعليم", "نجارة")
  createdAt DateTime @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  endorsements SkillEndorsement[]

  @@unique([userId, name]) // لا تكرار لنفس المهارة لنفس المستخدم
  @@index([userId])
  @@index([name])
}

model SkillEndorsement {
  id        String   @id @default(cuid())
  skillId   String
  endorserId String   // من يُصادق على المهارة
  createdAt DateTime @default(now())

  skill    Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  endorser User @relation(fields: [endorserId], references: [id], onDelete: Cascade)

  @@unique([skillId, endorserId]) // صادقة واحدة لكل مستخدم لكل مهارة
  @@index([skillId])
  @@index([endorserId])
}

// ===================================================================
//  v56.0 — Multi-City Architecture (Region + City + Country + Diaspora)
// ===================================================================

model Region {
  id        String  @id @default(cuid())
  name      String
  nameAr    String
  nameFr    String?
  code      String?  // HCP code
  slug      String  @unique
  population Int?
  latitude  Float?
  longitude Float?
  provinces     Province[]
  cities        City[]
  communes      Commune[]
  organizations Organization[]
  createdAt     DateTime @default(now())
}

// v70.0: Province/Préfecture (83) — المستوى الإداري الثاني
model Province {
  id        String  @id @default(cuid())
  name      String
  nameAr    String
  nameFr    String?
  code      String?  // HCP code
  slug      String  @unique
  regionId  String
  region    Region  @relation(fields: [regionId], references: [id])
  population Int?
  latitude  Float?
  longitude Float?
  cities        City[]
  communes      Commune[]
  organizations Organization[]
  createdAt     DateTime @default(now())

  @@index([regionId])
}

model City {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  nameFr      String?
  slug        String   @unique
  regionId    String?
  region      Region?  @relation(fields: [regionId], references: [id])
  provinceId String?
  province    Province? @relation(fields: [provinceId], references: [id])
  population  Int?
  latitude    Float?
  longitude   Float?
  coverImage  String?
  description String?
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  districts   District[]
  users       User[]
  createdAt   DateTime @default(now())

  @@index([regionId])
  @@index([slug])
}

model Country {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  nameFr      String?
  code        String   @unique
  flag        String?
  isDiaspora  Boolean   @default(true)
  diasporaCities DiasporaCity[]
  users       User[]
  createdAt   DateTime @default(now())
}

model DiasporaCity {
  id          String   @id @default(cuid())
  countryId   String
  country     Country  @relation(fields: [countryId], references: [id])
  name        String
  nameAr      String
  slug        String
  users       User[]

  @@unique([countryId, slug])
}

// v70.0: Commune (الجماعة) — المستوى الإداري الثالث (1,503 communes)
// Rural (جماعة قروية) | Urban (جماعة حضرية) | Prefectoral Arrondissement (مقاطعة)
model Commune {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  nameFr      String?
  code        String?  // HCP commune code
  slug        String   @unique
  type        String   @default("rural") // "rural" | "urban" | "arrondissement"
  provinceId  String
  province    Province @relation(fields: [provinceId], references: [id])
  regionId    String?
  region      Region?  @relation(fields: [regionId], references: [id])
  population  Int?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([provinceId])
  @@index([regionId])
}

// ===================================================================
//  v70.0 Section 4 — نظام المنظمات (Organizations System)
//  Models: Organization, OrganizationMember, LedgerEntry, LedgerAccount
//  Types:  ASSOCIATION (جمعية) | COOPERATIVE (تعاونية) | WEDADIA (تعاضدية)
//  Inspired by: Open Collective + French Mutuelle + Moroccan Loi 75-00
// ===================================================================

// Organization — كيان قانوني مغربي
model Organization {
  id              String   @id @default(cuid())
  name            String                          // "جمعية النور للتنمية"
  slug            String   @unique
  nameAr          String?
  nameFr          String?
  type            String   @default("ASSOCIATION") // ASSOCIATION | COOPERATIVE | WEDADIA
  registrationNumber String?                       // رقم التسجيل بـ walayat/ODC
  legalStatus     String?  @default("active")       // active | pending | suspended | dissolved
  utilitePublique Boolean  @default(false)          // "منفعة عامة" status
  description     String?
  mission         String?
  logoUrl         String?
  coverImageUrl   String?
  websiteUrl      String?
  email           String?
  phone           String?
  address         String?
  // Geographic scope
  country         String?  @default("MA")
  regionId        String?
  region          Region?  @relation(fields: [regionId], references: [id])
  provinceId      String?
  province        Province? @relation(fields: [provinceId], references: [id])
  communeId       String?
  // commune        Commune? @relation(fields: [communeId], references: [id])  // disabled — relation optional
  // Ledger / finance
  currency        String   @default("MAD")
  balance         Float    @default(0)              // running balance (cache)
  totalRaised     Float    @default(0)              // lifetime credits
  totalSpent      Float    @default(0)              // lifetime debits
  // Social
  membersCount    Int      @default(0)
  followersCount  Int      @default(0)
  verifiedBadge   Boolean  @default(false)          // verified by admin
  // Metadata
  foundedAt       DateTime?
  tags            String?                            // comma-separated tags
  isActive        Boolean  @default(true)
  ownerId         String?                           // User who created/manages
  // Relations
  members         OrganizationMember[]
  ledgerEntries   LedgerEntry[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([type])
  @@index([provinceId])
  @@index([regionId])
  @@index([slug])
}

// OrganizationMember — roles within an organization
model OrganizationMember {
  id              String    @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  // user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String    @default("member")    // president | treasurer | secretary | member | auditor
  joinedAt        DateTime  @default(now())
  approvedAt      DateTime?
  isActive        Boolean   @default(true)
  contribution    Float?                            // monthly membership fee (MAD)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

// LedgerEntry — Double-entry ledger (credit/debit)
// Inspired by Open Collective: each org has transparent transactions
model LedgerEntry {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryType       String                              // CREDIT | DEBIT
  amount          Float                                // positive amount in MAD
  currency        String   @default("MAD")
  description     String                               // "تبرع من السيد X"
  category        String?                              // donation | expense | membership | grant | salary | other
  source          String?                              // external | internal | system
  reference       String?                              // bank tx ref or receipt #
  attachmentUrl   String?
  // Actor
  createdBy       String?                              // userId (optional)
  createdByName   String?                              // display name (denormalized)
  // Status workflow
  status          String   @default("pending")          // pending | confirmed | rejected | reversed
  reviewedBy      String?
  reviewedAt      DateTime?
  // Dates
  occurredAt      DateTime @default(now())              // when tx actually happened
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([entryType])
  @@index([status])
  @@index([occurredAt])
}


// ===================================================================
//  v70.0 Section 5 — National Networking: Profile + Tag + Graph
//  Models: ProfileTag, NetworkMatch (collaborative+geo+graph)
// ===================================================================

// ProfileTag — tag-based profile matching
model ProfileTag {
  id        String   @id @default(cuid())
  userId    String
  tag       String                       // skill, interest, sector, language
  tagType   String   @default("skill")   // skill | interest | sector | language
  weight    Int      @default(1)         // 1-5 (strength of the tag)
  isPublic Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, tag, tagType])
  @@index([userId])
  @@index([tag, tagType])
}

// NetworkMatch — cached recommendations between two users
// Used by the /network discovery page
model NetworkMatch {
  id              String   @id @default(cuid())
  userId          String                     // the user receiving the rec
  targetUserId    String                     // the recommended user
  score           Float    @default(0)       // 0.0-1.0 (composite)
  scoreTags      Float    @default(0)       // collaborative+content
  scoreGeo        Float    @default(0)       // geographic proximity
  scoreGraph      Float    @default(0)       // 2nd-degree connections
  scoreOrg       Float    @default(0)       // shared organization
  reasons         String?                    // comma-separated human-readable reasons
  isViewed        Boolean  @default(false)
  isDismissed    Boolean  @default(false)
  isFollowed     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, targetUserId])
  @@index([userId, score])
  @@index([targetUserId])
}

// ===================================================================
//  v70.0 Section 6 — Resources & Skills Hub (PH + Show HN style)
// ===================================================================

// ResourceLink — a curated dev/entrepreneur/Morocco resource link
model ResourceLink {
  id           String   @id @default(cuid())
  title        String
  url          String   @unique
  description  String?
  category     String   @default("general")  // github | producthunt | hackernews | article | tool | course | morocco
  tags         String?                          // comma-separated
  submittedById String?
  submittedBy  String?                          // denormalized name
  sourcePlatform String?                        // GitHub | Product Hunt | Hacker News | Manual
  sourceExternalId String?                      // external id for dedup
  pinned       Boolean  @default(false)
  pinnedAt     DateTime?
  pinnedOrder  Int?
  upvotes      Int      @default(0)
  downvotes    Int      @default(0)
  viewsCount   Int      @default(0)
  commentsCount Int     @default(0)
  // Geographic relevance (optional) — store as plain strings, no FK relation
  // (avoids breaking reverse relation field requirements)
  regionName   String?
  provinceName String?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  votes        ResourceVote[]

  @@index([category])
  @@index([pinned, pinnedOrder])
  @@index([upvotes])
  @@index([publishedAt])
}

// ResourceVote — a vote (up or down) on a resource link
model ResourceVote {
  id          String   @id @default(cuid())
  resourceId  String
  resource    ResourceLink @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId      String?
  voterName   String?
  vote        Int      @default(1)        // 1 = upvote, -1 = downvote
  createdAt   DateTime @default(now())

  @@unique([resourceId, userId])
  @@index([resourceId])
}
