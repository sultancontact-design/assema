// ===================================================================
//  سيدي يوسف بن علي العاصمة — منصة المعروف الرقمي
//  Prisma Schema (MVP — 5 وحدات)
//  متوافق مع SQLite (محلي) و PostgreSQL (إنتاج Supabase)
//  كل الجداول: id, createdAt, updatedAt, deletedAt (Soft Delete)
// ===================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===================================================================
//  Enums (تُخزَّن كنصوص في SQLite، Enum في PostgreSQL)
// ===================================================================

// الأدوار الثمانية
enum Role {
  GUEST           // زائر
  MEMBER          // عضو
  GROUP_LEADER    // رئيس مجموعة
  DISTRICT_MOD    // مشرف حي
  TREASURER       // أمين الصندوق
  ETHICS_COMMITTEE // لجنة النزاهة
  SUPER_ADMIN     // سوبر أدمن
  ADS_MANAGER     // مسؤول إعلانات
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DISABLED
}

enum ContributionStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum ContributionMethod {
  BANK_TRANSFER   // تحويل بنكي
  CASH            // نقداً عبر أمين الصندوق
  CMI             // CMI (للمرحلة المدفوعة)
}

enum FundRequestType {
  MEDICAL         // مرض
  DEATH           // وفاة
  WEDDING         // عرس
  EDUCATION       // تعليم
  EMERGENCY       // طوارئ
  MICRO_PROJECT   // مشروع صغير
}

enum FundRequestStatus {
  SUBMITTED       // مُقدَّم
  UNDER_REVIEW    // قيد المراجعة
  APPROVED        // موافَق
  REJECTED        // مرفوض
  DISBURSED       // مَصروف
  COMPLETED       // مكتمل
}

enum ApprovalDecision {
  APPROVE
  REJECT
  ABSTAIN
}

enum EventType {
  MONTHLY         // شهري
  SEASONAL        // موسمي
  SPECIAL         // خاص
  SOLIDARITY      // تضامني
  CULTURAL        // ثقافي
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  SYSTEM
  CONTRIBUTION
  FUND_REQUEST
  EVENT
  GROUP
  COMPLAINT
  ANNOUNCEMENT
}

enum ComplaintType {
  FINANCIAL
  BEHAVIORAL
  TECHNICAL
  SUGGESTION
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum AdStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
}

enum AdPackage {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  SPONSOR
}

// ===================================================================
//  النماذج الأساسية
// ===================================================================

model District {
  id          String   @id @default(cuid())
  name        String   @unique   // "سيدي يوسف بن علي"
  slug        String   @unique
  // أسماء ثنائية اللغة (عربي + فرنسي) للعرض على الخريطة
  nameAr       String?
  nameFr       String?
  // إحصاءات سكانية ومنصوية لكل حي
  population   Int?
  members      Int     @default(0)
  familiesCount Int   @default(0)
  contributions Int   @default(0)
  city        String   @default("مراكش")
  region      String   @default("مراكش آسفي")
  description String?
  // حدود الحي (SVG path) — خريطة حرارية محلية
  boundarySvg String?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)

  families    Family[]
  users       User[]
  groups      Group[]
  events      Event[]
  ads         Ad[]
  complaints  Complaint[]
  guideItems  GuideItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([isActive])
}

model Family {
  id              String   @id @default(cuid())
  familyName      String   // "بنشقرون"
  districtId      String
  district        District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  headOfFamilyId  String?  // رب الأسرة (User)
  headOfFamily    User?    @relation("FamilyHead", fields: [headOfFamilyId], references: [id])
  address         String?
  economicStatus  String   @default("متوسط") // ضعيف / متوسط / جيد
  memberCount     Int      @default(1)
  isActive        Boolean  @default(true)
  notes           String?

  members         User[]
  contributions   Contribution[]
  fundRequests    FundRequest[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([districtId])
  @@index([familyName])
}

model User {
  id                String       @id @default(cuid())
  // الهوية
  firstName         String       // الاسم الشخصي
  lastName          String       // اسم العائلة
  fullName          String       // "محمد بنشقرون" (مولّد)
  email             String       @unique
  phone             String       @unique  // 06XXXXXXXX
  nationalIdHash    String?      // رقم البطاقة الوطنية (مشفّر)
  passwordHash      String       // bcrypt
  avatar            String?
  // العلاقات
  districtId        String
  district          District     @relation(fields: [districtId], references: [id])
  familyId          String?
  family            Family?      @relation(fields: [familyId], references: [id])
  isFamilyHead      Boolean      @default(false)
  // الدور والحالة
  role              Role         @default(MEMBER)
  status            UserStatus   @default(PENDING)
  emailVerified     DateTime?
  // التفاصيل الاجتماعية
  profession        String?      // "معلم"
  skills            String?      // مفصولة بفاصلة
  interests         String?
  birthDate         DateTime?
  gender            String?      // ذكر/أنثى
  // الأمان
  twoFactorEnabled  Boolean      @default(false)
  twoFactorSecret   String?
  twoFactorBackupCodes String?  // JSON array of bcrypt-hashed 8-char backup codes
  failedLoginCount  Int          @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  // نقاط اللعب (Gamification)
  points            Int          @default(0)
  level             Int          @default(1)
  badges            String?      // JSON array of badge IDs

  // العلاقات
  familyHeadOf      Family[]     @relation("FamilyHead")
  contributions     Contribution[]
  fundRequests      FundRequest[]
  approvalsGiven    FundRequestApproval[]
  groupsLed         GroupMember[] @relation("GroupLeader")
  groupMemberships  GroupMember[]
  eventRegistrations EventRegistration[]
  notifications     Notification[]
  complaintsFiled   Complaint[]  @relation("ComplaintFiledBy")
  complaintsHandled Complaint[]  @relation("ComplaintHandledBy")
  auditLogs         AuditLog[]
  adsManaged        Ad[]         @relation("AdManager")
  
  // ─────────── علاقات هندسة الإدمان (v3.0) ───────────
  streak            UserStreak?
  variableRewards   VariableReward[]
  userChallenges    UserChallenge[]
  userBadges        UserBadge[]
  activities        UserActivity[]
  following         UserRelationship[] @relation("Follower")
  followers         UserRelationship[] @relation("Following")
  smartNotifications SmartNotification[]
  notificationPref  NotificationPreference?
  sentMessages      DirectMessage[] @relation("MessageSender")
  receivedMessages   DirectMessage[] @relation("MessageReceiver")
  discussions       Discussion[]
  discussionReplies  DiscussionReply[]
  initiatives       Initiative[]
  initiativeVotes   InitiativeVote[]

  // ─────────── الاقتصاد والمتجر (v5.0) ───────────
  pointsLedger      PointsLedger[]
  storeOrders       StoreOrder[]

  // ─────────── الإحالة والمرجع (v7.0) ───────────
  referrals         Referral[]
  blogPosts         BlogPost[]
  guideItems        GuideItem[]


  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([districtId])
  @@index([familyId])
  @@index([role])
  @@index([status])
  @@index([phone])
}

// ===================================================================
//  نظام الإحالة (Referral) — v7.0
//  - يولّد كل مستخدم رمزاً فريداً 8 حروف/أرقام
//  - يربح 50 نقطة لكل إحالة تُكمَل (refereeId يُسجّل دخوله)
// ===================================================================

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  refereeId   String?
  code        String   @unique
  status      String   @default("PENDING") // PENDING, SIGNED_UP, ACTIVE
  reward      Int      @default(50)
  createdAt   DateTime @default(now())
  completedAt DateTime?
  user        User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

// ===================================================================
//  المدوّنة (BlogPost) — v7.0
//  - مقالات ومحتوى توعوي: صحة، تربية، مالية، دينية، مجتمع، تعليم
// ===================================================================

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  category    String   // HEALTH, EDUCATION, FINANCE, PARENTING, RELIGIOUS, COMMUNITY
  authorId    String?
  imageUrl    String?
  tags        String?
  status      String   @default("published") // draft, published, archived
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([category])
  @@index([status])
}

// ===================================================================
//  دليل الحي (GuideItem) — v7.0
//  - أماكن مفيدة في الحي: مقاهي، مطاعم، محلات، مدارس، مراكز صحية،
//    مساجد، خدمات، جمعيات
// ===================================================================

model GuideItem {
  id          String   @id @default(cuid())
  name        String
  category    String   // CAFE, RESTAURANT, SHOP, SCHOOL, HEALTH, MOSQUE, SERVICE, ASSOCIATION
  address     String?
  phone       String?
  description String?
  districtId  String?
  latitude    Float?
  longitude   Float?
  rating      Float    @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  creator     User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  district    District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([districtId])
}

// ===================================================================
//  الاقتصاد (Points Economy) — v5.0
//  - PointsLedger: سجلّ كل معاملة نقاط (كسب/صرف/تعديل/شراء/تحويل)
// ===================================================================

model PointsLedger {
  id           String   @id @default(cuid())
  userId       String
  amount       Int      // موجب=كسب، سالب=صرف
  type         String   // EARN, SPEND, ADJUST, PURCHASE, TRANSFER
  reason       String
  adminId      String?  // من قام بالتعديل اليدوي
  balanceAfter Int      // رصيد المستخدم بعد هذه المعاملة
  metadata     String?  // JSON

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ===================================================================
//  المتجر (Store) — v5.0
// ===================================================================

model StoreItem {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String   // emoji
  pricePoints Int      // التكلفة بالنقاط
  type        String   // FREEZE, BADGE, DISCOUNT, FEATURE, DIGITAL
  stock       Int?     // null = غير محدود
  isActive    Boolean  @default(true)
  metadata    String?  // JSON

  orders      StoreOrder[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([type])
}

model StoreOrder {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  pricePaid   Int      // النقاط المصروفة
  status      String   @default("completed") // pending, completed, refunded
  metadata    String?  // JSON

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([itemId])
  @@index([status])
}

// ===================================================================
//  المجموعات (Interest Groups)
// ===================================================================

model Group {
  id          String         @id @default(cuid())
  name        String         // "مجموعة الأمهات"
  slug        String         @unique
  description String?
  districtId  String
  district    District       @relation(fields: [districtId], references: [id], onDelete: Cascade)
  category    String         @default("عام")
  icon        String?
  coverImage  String?
  isDefault   Boolean        @default(false) // المجموعات الافتراضية
  isActive    Boolean        @default(true)
  // الإعدادات
  isPrivate   Boolean        @default(false) // انضمام بدعوة
  maxMembers  Int?
  // العلاقات
  members     GroupMember[]
  events      Event[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([districtId])
  @@index([slug])
}

model GroupMember {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // leader / moderator / member
  joinedAt    DateTime  @default(now())
  isApproved  Boolean   @default(true)

  // العلاقة العكسية لرئيس المجموعة
  ledBy       User[]    @relation("GroupLeader")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([userId])
}

// ===================================================================
//  صندوق المعروف الرقمي (Digital Maârouf Fund)
// ===================================================================

model Contribution {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId      String
  family        Family              @relation(fields: [familyId], references: [id])
  districtId    String
  // المبلغ والشهر
  amount        Float               // بالدرهم
  month         String              // "2024-01"
  year          Int
  // الدفع
  method        ContributionMethod  @default(BANK_TRANSFER)
  receiptNumber String?             // رقم الإيصال الرقمي (مولّد)
  receiptImage  String?             // مسار صورة الإيصال المرفوعة
  bankReference String?             // مرجع التحويل البنكي
  // الحالة
  status        ContributionStatus  @default(PENDING)
  confirmedById String?
  confirmedAt   DateTime?
  note          String?
  // الإيصال الرقمي (UUID لكل مساهمة)
  digitalReceipt String?            @unique

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([status])
  @@index([month])
  @@index([year])
}

model FundRequest {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId        String
  family          Family              @relation(fields: [familyId], references: [id])
  districtId      String
  // نوع الطلب
  type            FundRequestType
  amountRequested Float
  amountApproved  Float?
  amountDisbursed Float?
  // التفاصيل
  title           String
  description     String
  // المرفقات (JSON array of file paths)
  attachments     String?
  // الموقع (مستشفى، إلخ)
  location        String?
  // الحالة
  status          FundRequestStatus   @default(SUBMITTED)
  // الموافقات
  approvals       FundRequestApproval[]
  // متى يحتاج لجنة النزاهة؟
  requiresEthics  Boolean             @default(false) // true إذا > 1000 درهم
  reviewedById    String?
  reviewedAt      DateTime?
  reviewedNote    String?
  disbursedAt     DateTime?
  disbursedById   String?
  disbursementMethod String?
  disbursementRef String?
  // الإيصال النهائي
  finalReceipt    String?             @unique
  completedAt     DateTime?
  // الكرامة: رقم رمزي بدل الاسم في العلن
  anonymousCode   String?             // "SY-001"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([familyId])
  @@index([status])
  @@index([type])
}

model FundRequestApproval {
  id          String           @id @default(cuid())
  requestId   String
  request     FundRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User             @relation(fields: [approverId], references: [id])
  decision    ApprovalDecision
  note        String?
  // متى صوّت
  decidedAt   DateTime         @default(now())

  createdAt   DateTime @default(now())

  @@unique([requestId, approverId])
  @@index([requestId])
}

// ===================================================================
//  الفعاليات والمناسبات (Events)
// ===================================================================

model Event {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  description     String
  districtId      String
  district        District    @relation(fields: [districtId], references: [id], onDelete: Cascade)
  // النوع والتاريخ
  type            EventType
  status          EventStatus  @default(DRAFT)
  startDate       DateTime
  endDate         DateTime?
  location        String
  // خريطة SVG محلية للموقع
  locationMapSvg  String?
  // الصور
  coverImage      String?
  galleryImages   String?      // JSON array
  // التذاكر
  maxAttendees    Int?
  isRegistrationOpen Boolean   @default(true)
  requiresApproval Boolean     @default(false)
  // العلاقات
  groupId         String?
  group           Group?       @relation(fields: [groupId], references: [id])
  organizerId     String?
  registrations   EventRegistration[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([districtId])
  @@index([status])
  @@index([startDate])
}

model EventRegistration {
  id          String             @id @default(cuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // التذكرة الرقمية
  qrCode      String             @unique  // محتوى QR (سيُولَّد كـ SVG)
  ticketCode  String             @unique  // "EV-2024-001"
  status      RegistrationStatus @default(REGISTERED)
  registeredAt DateTime         @default(now())
  attendedAt  DateTime?
  // معلومات إضافية
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

// ===================================================================
//  الإشعارات (Notifications)
// ===================================================================

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?            // "/community/fund/requests/123"
  isRead    Boolean            @default(false)
  readAt    DateTime?
  metadata  String?            // JSON

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([type])
}

// ===================================================================
//  الإعلانات والرعايات (Ads & Sponsorships) — placeholder
// ===================================================================

model Ad {
  id            String      @id @default(cuid())
  title         String
  advertiserName String
  advertiserEmail String?
  advertiserPhone String?
  districtId    String
  district      District    @relation(fields: [districtId], references: [id], onDelete: Cascade)
  // الحزمة
  package       AdPackage   @default(BRONZE)
  // المحتوى
  imageUrl      String?
  targetUrl     String?
  placement     String      @default("sidebar") // header / sidebar / in-feed / footer / popup
  // التواريخ
  startDate     DateTime
  endDate       DateTime
  // الحالة
  status        AdStatus    @default(PENDING)
  // الإحصاءات
  views         Int         @default(0)
  clicks        Int         @default(0)
  // السعر
  amountPaid    Float        @default(0)
  // الإدارة
  managerId     String?
  manager       User?       @relation("AdManager", fields: [managerId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([districtId, status])
  @@index([status])
  @@index([endDate])
}

// ===================================================================
//  AdSlot — مساحة إعلانية مستقلّة (7 مواضع)
//  - مواضع: HEADER, SIDEBAR_TOP, SIDEBAR_BOTTOM, IN_FEED, FOOTER, LEFT, RIGHT
//  - أنواع: IMAGE, SCRIPT, HTML, ADSENSE
//  - تتبّع الظهور (views) والنقرات (clicks)
//  - أولوية (priority) + فترة صلاحية (startDate/endDate)
// ===================================================================

model AdSlot {
  id          String   @id @default(cuid())
  name        String
  position    String   // HEADER, SIDEBAR_TOP, SIDEBAR_BOTTOM, IN_FEED, FOOTER, LEFT, RIGHT
  type        String   // IMAGE, SCRIPT, HTML, ADSENSE
  content     String?
  imageUrl    String?
  linkUrl     String?
  width       Int?
  height      Int?
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  clicks      Int      @default(0)
  views       Int      @default(0)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([position, isActive])
  @@index([isActive])
}

// ===================================================================
//  الشكاوى والاقتراحات (Complaints & Feedback)
// ===================================================================

model Complaint {
  id          String          @id @default(cuid())
  // إن كانت مجهولة
  isAnonymous Boolean         @default(false)
  // الجهة المشتكية
  filedById   String?
  filedBy     User?           @relation("ComplaintFiledBy", fields: [filedById], references: [id])
  districtId  String?
  district    District?       @relation(fields: [districtId], references: [id])
  // المحتوى
  type        ComplaintType
  subject     String
  description String
  attachments String?         // JSON array
  // الإدارة
  status      ComplaintStatus @default(OPEN)
  priority    String          @default("normal") // low/normal/high/urgent
  handledById String?
  handledBy   User?           @relation("ComplaintHandledBy", fields: [handledById], references: [id])
  resolution String?
  resolvedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([districtId])
}

// ===================================================================
//  سجل النشاط (Audit Log)
// ===================================================================

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  action      String   // "user.login", "fund.request.approved"
  entity      String?  // "User", "FundRequest"
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    String?  // JSON
  // الخطور
  severity    String   @default("info") // info/warning/critical

  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
}

// ===================================================================
//  الإعدادات (Settings) — Key-Value
// ===================================================================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique  // "site.name", "fund.threshold.ethics"
  value       String
  type        String   @default("string") // string/int/bool/json
  category    String   @default("general")
  isPublic    Boolean  @default(true)
  description String?

  updatedAt   DateTime @updatedAt
}

// ===================================================================
//  سجل البريد الإلكتروني (Email Log) — تتبّع كل بريد مُرسَل
// ===================================================================

model EmailLog {
  id         String    @id @default(cuid())
  to         String
  subject    String
  body       String    // HTML body
  status     String    @default("sent") // sent | failed | pending
  error      String?
  messageId  String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([to])
  @@index([createdAt])
}

// ===================================================================
//  قائمة IP المسموح بها (IP Allowlist)
//  - تُفعَّل عبر Setting: security.ip_allowlist.enabled
//  - عند التفعيل، يُسمح فقط بـIP المُدرجة في هذا الجدول
// ===================================================================

model AllowedIP {
  id        String   @id @default(cuid())
  ip        String   @unique
  note      String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ===================================================================
//  هندسة الإدمان (Engagement Engineering) — v3.0
//  مستوحاة من Octalysis Framework + Hook Model + Prospect Theory
// ===================================================================

// ─────────── المحور 1: السلاسل (Streaks) ───────────
model UserStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActivity  DateTime?
  freezes       Int       @default(2)  // 2 freezes مجانية
  freezeUsedAt  DateTime?
  lastCheckIn   DateTime? // آخر تسجيل دخول يومي
  totalCheckIns Int       @default(0)
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([userId])
}

// ─────────── المحور 2: المكافآت المتغيرة ───────────
model VariableReward {
  id          String   @id @default(cuid())
  userId      String
  type        String   // MYSTERY_BOX, SPIN_WHEEL, LUCKY_DRAW
  reward      String   // POINTS, FREEZE, BADGE, DISCOUNT
  value       Int      // عدد النقاط أو قيمة المكافأة
  badgeId     String?  // معرّف الشارة إن كانت المكافأة شارة
  drawnAt     DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge?   @relation(fields: [badgeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([drawnAt])
}

// ─────────── المحور 3: الندرة (Scarcity) ───────────
model Challenge {
  id          String    @id @default(cuid())
  title       String
  description String
  type        String    // SEASONAL, DAILY, WEEKLY, LIMITED
  status      String    @default("active") // active, expired, completed
  pointsReward Int      @default(0)
  requiredCount Int     @default(1) // عدد المهام المطلوبة
  startDate   DateTime
  endDate     DateTime
  badgeId     String?
  
  participants UserChallenge[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([status])
  @@index([endDate])
}

model UserChallenge {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
}

// ─────────── الشارات ───────────
model Badge {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String
  icon        String    // emoji أو SVG name
  rarity      String    @default("common") // common, rare, epic, legendary
  isLimited   Boolean   @default(false)
  availableFrom DateTime?
  availableUntil DateTime?
  maxRecipients Int?     // أقصى عدد مستفيدين (للندرة)
  currentRecipients Int  @default(0)
  
  userBadges  UserBadge[]
  rewards     VariableReward[]

  createdAt   DateTime  @default(now())

  @@index([rarity])
  @@index([isLimited])
}

model UserBadge {
  id          String    @id @default(cuid())
  userId      String
  badgeId     String
  earnedAt    DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// ─────────── المحور 4: الدليل الاجتماعي ───────────
model UserActivity {
  id          String    @id @default(cuid())
  userId      String
  type        String    // LOGIN, CONTRIBUTION, FUND_REQUEST, EVENT_REGISTER, GROUP_JOIN, BADGE_EARNED, STREAK_MILESTONE
  description String
  metadata    String?   // JSON
  isPublic    Boolean   @default(true)
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  
  @@index([userId, isPublic])
  @@index([createdAt])
  @@index([type])
}

// ─────────── المحور 7: الاستثمار — العلاقات ───────────
model UserRelationship {
  id          String    @id @default(cuid())
  followerId  String    // من يتابع
  followingId String   // من يُتابَع
  status      String    @default("active") // active, blocked
  createdAt   DateTime  @default(now())
  
  follower    User      @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User      @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ─────────── المحور 6: الإشعارات الذكية ───────────
model SmartNotification {
  id          String    @id @default(cuid())
  userId      String
  type        String    // STREAK, MYSTERY_BOX, SOCIAL, URGENCY, REWARD, CHALLENGE, LOSS, ACHIEVEMENT, RECOMMENDATION, WELCOME_BACK
  title       String
  body        String
  actionUrl   String?
  icon        String?   // emoji
  sentAt      DateTime  @default(now())
  openedAt    DateTime?
  expiresAt   DateTime?
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  
  @@index([userId, openedAt])
  @@index([type])
  @@index([sentAt])
}

// ─────────── إعدادات الإشعارات (opt-in/opt-out) ───────────
model NotificationPreference {
  id          String    @id @default(cuid())
  userId      String    @unique
  streakAlerts Boolean  @default(true)
  mysteryBoxAlerts Boolean @default(true)
  socialAlerts Boolean @default(true)
  urgencyAlerts Boolean @default(true)
  rewardAlerts Boolean @default(true)
  challengeAlerts Boolean @default(true)
  lossAlerts Boolean   @default(true)
  achievementAlerts Boolean @default(true)
  recommendationAlerts Boolean @default(true)
  welcomeBackAlerts Boolean @default(true)
  quietHoursStart Int  @default(22) // 10م — لا إشعارات
  quietHoursEnd Int    @default(7)  // 7ص
  dailyLimit Int       @default(5)  // أقصى 5/يوم
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─────────── المحور 9: لوحة الإدمان ───────────
model EngagementMetric {
  id          String    @id @default(cuid())
  date        DateTime  @default(now())
  dau         Int       @default(0)   // Daily Active Users
  mau         Int       @default(0)   // Monthly Active Users
  newUsers    Int       @default(0)
  retentionD1 Float     @default(0)  // Retention Day 1
  retentionD7 Float     @default(0)  // Retention Day 7
  retentionD30 Float    @default(0)  // Retention Day 30
  avgSessionTime Int   @default(0)  // seconds
  avgSessionsPerUser Float @default(0)
  avgStreak   Float    @default(0)
  mysteryBoxesOpened Int @default(0)
  spinWheelsUsed Int   @default(0)
  challengesCompleted Int @default(0)
  notificationsSent Int @default(0)
  notificationsOpened Int @default(0)
  notificationOpenRate Float @default(0)
  
  createdAt   DateTime  @default(now())
  
  @@index([date])
}

// ===================================================================
//  التفاعل الاجتماعي — v9.0
//  DirectMessage + Discussion + DiscussionReply + Initiative + InitiativeVote
// ===================================================================

// الرسائل المباشرة بين المستخدمين
model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String
  readAt      DateTime?
  createdAt   DateTime @default(now())
  
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  
  @@index([senderId])
  @@index([receiverId, readAt])
  @@index([createdAt])
}

// النقاشات الجماعية
model Discussion {
  id          String   @id @default(cuid())
  title       String
  content     String
  authorId    String
  groupId     String?   // optional: linked to a group
  districtId  String?  // optional: linked to a district
  category    String   @default("general") // general, question, suggestion, announcement
  isPinned    Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies     DiscussionReply[]
  
  @@index([authorId])
  @@index([groupId])
  @@index([districtId])
  @@index([createdAt])
}

model DiscussionReply {
  id           String   @id @default(cuid())
  discussionId String
  authorId     String
  content      String
  parentId     String?   // for nested replies
  likes        Int       @default(0)
  createdAt    DateTime  @default(now())
  
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  @@index([discussionId])
  @@index([authorId])
}

// المبادرات والاقتراحات
model Initiative {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // EDUCATION, HEALTH, ENVIRONMENT, CULTURE, SOCIAL, INFRASTRUCTURE
  status      String   @default("proposed") // proposed, under_review, approved, rejected, in_progress, completed
  proposerId  String
  districtId  String?
  targetDate  DateTime?
  votes       Int      @default(0)
  budget      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  proposer    User     @relation(fields: [proposerId], references: [id], onDelete: Cascade)
  supporters  InitiativeVote[]
  
  @@index([status])
  @@index([category])
  @@index([districtId])
  @@index([createdAt])
}

model InitiativeVote {
  id          String   @id @default(cuid())
  initiativeId String
  userId      String
  createdAt   DateTime @default(now())
  
  initiative  Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([initiativeId, userId])
  @@index([initiativeId])
}

// ===================================================================

// ===================================================================
//  صلاحيات تحميل PDF (Download Permissions)
// ===================================================================

model DownloadPermission {
  id           String   @id @default(cuid())
  userId       String
  reportType   String   // FUND_REPORT, EVENT_REPORT, USER_DATA, LEDGER, ALL
  grantedBy    String
  grantedAt    DateTime @default(now())
  expiresAt    DateTime?
  isActive     Boolean  @default(true)
  
  @@index([userId, isActive])
  @@index([reportType])
}

model DownloadLog {
  id           String   @id @default(cuid())
  userId       String
  reportType   String
  reportId     String?
  downloadedAt DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  status       String   // GRANTED, DENIED
  reason       String?
  
  @@index([userId])
  @@index([status])
  @@index([downloadedAt])
}

// ===================================================================
//  v14.1 — قسم الخدمات الشامل + النصائح
// ===================================================================

model Service {
  id           String   @id @default(cuid())
  title        String
  titleAr      String
  description  String
  category     String   // PROFESSION, CRAFT, ADVICE, HEALTH, EDUCATION
  subcategory  String?
  providerId   String?
  districtId  String?
  phone        String?
  whatsapp     String?
  address      String?
  price        String?
  availability String?
  rating       Float    @default(0)
  reviews      Int      @default(0)
  images       String?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  serviceReviews ServiceReview[]
  
  @@index([category, isActive])
  @@index([districtId])
  @@index([isActive])
}

model ServiceReview {
  id        String   @id @default(cuid())
  serviceId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  @@unique([serviceId, userId])
  @@index([serviceId])
}

model Advice {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   // HEALTH, EDUCATION, FINANCE, RELIGION, FAMILY
  authorId    String?
  isPublic    Boolean  @default(true)
  likes       Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  
  @@index([category, isPublic])
  @@index([createdAt])
}

// ===================================================================
//  v14.1 — أسعار السوق (Market Prices)
// ===================================================================

model MarketPrice {
  id          String   @id @default(cuid())
  productName String
  productNameAr String
  category    String   // VEGETABLE, FRUIT, MEAT, GRAIN, DAIRY, OTHER
  price       Float    // درهم/كغ
  unit        String   @default("درهم/كغ")
  market      String?  // اسم السوق
  districtId  String?
  source      String   @default("user") // user, admin, official
  reportedBy  String?
  reportedAt  DateTime @default(now())
  validUntil  DateTime?
  isActive    Boolean  @default(true)
  
  @@index([category, isActive])
  @@index([productName])
  @@index([reportedAt])
}

// ===================================================================
//  v14.2 — أسعار السوق التلقائية (Auto Market Prices)
// ===================================================================

model Product {
  id          String   @id @default(cuid())
  name        String   @unique
  nameAr      String
  category    String   // VEGETABLE, FRUIT, GRAIN, MEAT, DAIRY
  unit        String   @default("KG")
  icon        String?
  isActive    Boolean  @default(true)
  prices      Price[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([category, isActive])
}

model Price {
  id          String   @id @default(cuid())
  productId   String
  districtId  String?
  marketName  String?
  minPrice    Float
  maxPrice    Float
  avgPrice    Float?
  unit        String   @default("KG")
  source      String   // PRIXAGRICULTURE, DATA_GOV, HCP, FAOSTAT, SEASONAL_FALLBACK, USER
  sourceUrl   String?
  reportedBy  String?
  verified    Boolean  @default(false)
  recordedAt  DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, recordedAt])
  @@index([source])
  @@index([recordedAt])
}

model PriceReport {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  districtId  String?
  price       Float
  marketName  String?
  notes       String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote   String?
  createdAt   DateTime @default(now())
  @@index([userId])
  @@index([status])
}

model PriceFetchLog {
  id            String   @id @default(cuid())
  source        String
  status        String   // SUCCESS, FAILED, PARTIAL, FALLBACK
  productsCount Int      @default(0)
  errorMessage  String?
  durationMs    Int?
  fetchedAt     DateTime @default(now())
  @@index([source, fetchedAt])
  @@index([fetchedAt])
}
